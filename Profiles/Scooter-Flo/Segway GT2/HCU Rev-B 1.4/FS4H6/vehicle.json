{
  "schema_version": 2,
  "name": "Segway GT2 Rev-B Master",
  "drivetrain": {
    "motor_count": 0,
    "motors": []
  },
  "vesc": {
    "enabled": false,
    "connection": {
      "type": "can",
      "bus": "can_main"
    },
    "limits": {
      "front_motor_current_a": null,
      "rear_motor_current_a": null,
      "front_ebrake_current_a": null,
      "rear_ebrake_current_a": null
    }
  },
  "addons": {
    "vesc_express": {
      "enabled": false,
      "local_can_id": 253,
      "target_vesc_id": 1
    }
  },
  "ride_modes": {
    "default_mode": "drive",
    "modes": [
      {
        "id": "eco",
        "name": "Eco",
        "enabled": true,
        "limits": {
          "front_motor_current_a": null,
          "rear_motor_current_a": null,
          "front_ebrake_current_a": null,
          "rear_ebrake_current_a": null,
          "battery_regen_current_a": null,
          "speed_limit_kmh": null
        }
      },
      {
        "id": "drive",
        "name": "Drive",
        "enabled": true,
        "limits": {
          "front_motor_current_a": null,
          "rear_motor_current_a": null,
          "front_ebrake_current_a": null,
          "rear_ebrake_current_a": null,
          "battery_regen_current_a": null,
          "speed_limit_kmh": null
        }
      },
      {
        "id": "race",
        "name": "Race",
        "enabled": true,
        "limits": {
          "front_motor_current_a": null,
          "rear_motor_current_a": null,
          "front_ebrake_current_a": null,
          "rear_ebrake_current_a": null,
          "battery_regen_current_a": null,
          "speed_limit_kmh": null
        }
      }
    ]
  },
  "reverse": {
    "enabled": false
  },
  "connectivity": {
    "wifi": {
      "enabled": false,
      "mode": "auto",
      "ap": {
        "ssid": "ScooterOS GT2",
        "ipv4": "192.168.4.1",
        "ssid_hidden": false
      }
    },
    "bluetooth": {
      "enabled": false,
      "advertise_name": false
    }
  },
  "security": {
    "maintenance": {
      "pairing_window_seconds": 120,
      "session_max_seconds": 600
    }
  },
  "power_management": {
    "enabled": false,
    "shutdown_mode": "automatic",
    "idle_shutdown": {
      "enabled": true,
      "timeout_sec": 600,
      "warning_sec": 10,
      "reset_on_controls": true,
      "reset_on_touch": true,
      "require_standstill": true
    },
    "soft_off_timeout_sec": 1800,
    "wake_sources": {
      "button": false,
      "charger": false,
      "motion": false,
      "can": false,
      "timer": false,
      "touch": false
    },
    "charging": {
      "keep_awake": true
    },
    "alarm": {
      "keep_awake": true,
      "power_state": "soft_off",
      "runtime_warning": {
        "enabled": true,
        "show_on_activation": true
      },
      "low_battery": {
        "priority": "alarm",
        "critical_action": "keep_alive",
        "respect_battery_protection": true
      }
    },
    "battery_protection": {
      "enabled": true,
      "warning_percent": 20
    }
  },
  "board_id": "gt2_hcu_rev_b_master",
  "scheduler": {
    "mode": "custom",
    "tasks": {
      "core_update": {
        "cpu": 1,
        "priority": 5,
        "interval_ms": 100
      }
    }
  },
  "filesystem": {
    "browser": {
      "default_visible": true,
      "visibility": {
        "/bios.json": true,
        "/vehicle.json": true,
        "/.system": true,
        "/.system/wifi.json": true,
        "/user": true,
        "/nvs": true,
        "/nvs/user_name.json": true,
        "/nvs/ap_pass.json": true,
        "/nvs/wizard_step.json": true
      }
    }
  },
  "diagnostics": {
    "can_listen_only": false,
    "vesc_can_ids": [
      1,
      2
    ]
  },
  "failsafe": {
    "brake_stuck_warning_ms": 120000
  },
  "throttle_calibration": {
    "mode": "after_setup",
    "allow_skip": true,
    "preset": {
      "rest_raw": null,
      "full_raw": null
    },
    "min_span_raw": 600,
    "deadzone_percent": 3
  },
  "settings_access": {
